# ── Source credentials & keys ──────────────────────────────────────────────
# Copy to `.env.local`. Every value is optional — a source (or its richer mode)
# simply stays off and reports that honestly when the value is absent.

# Google / web search backend. Priority: Munshot > SerpAPI > Google
# Programmable Search > keyless fallback. Set ONE for reliable server-side
# results (the keyless fallback is blocked from most cloud servers).

# Munshot web-search (Brave-powered) — recommended, uses tooling you own.
MUNSHOT_TOKEN=
# Optional overrides:
MUNSHOT_SEARCH_URL=https://fastapi.muns.io/tools/web-search
MUNSHOT_COUNTRY=IN

# Exchange filings & announcements (BSE/NSE/DRHP/screener.in). Same Muns
# platform, so it reuses MUNSHOT_TOKEN by default — set FILINGS_TOKEN only to
# override. Needs a stock ticker on the search (e.g. RELIANCE).
FILINGS_TOKEN=
FILINGS_URL=https://devde.muns.io/filings/combined_filings_announcements
FILINGS_COUNTRY=India

# ...or SerpAPI:
SERPAPI_KEY=
# ...or Google Programmable Search:
GOOGLE_API_KEY=
GOOGLE_CX=

# Indian Kanoon — optional official API token. Without it, the public search
# page is used.
INDIANKANOON_API_TOKEN=

# MCA (Ministry of Corporate Affairs) — official Indian company registry, the
# authoritative source for directors + financials of UNLISTED companies. MCA has
# no free public API, so this uses a data-provider endpoint. Without the token
# the source skips honestly. MCA_API_URL takes ?q=<company name/CIN>.
MCA_API_TOKEN=
MCA_API_URL=https://api.mca.gov.in/company

# Wikidata (Directors) — FREE, keyless. Surfaces a company's directors, CEO,
# chairperson and founders, and (in director mode) the companies a person leads.
# No credential needed. Set a contact URL/email so Wikimedia can reach you per
# their API etiquette; the URL/SPARQL overrides are only for self-hosted mirrors.
WIKIDATA_CONTACT=https://github.com/techmuns/GCheck-Pragon
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# PrivateCircle — login for the Playwright collector (directorships).
PRIVATECIRCLE_EMAIL=
PRIVATECIRCLE_PASSWORD=

# CIBIL Suit-Filed portal — login for the Playwright collector (defaulters).
CIBIL_USERNAME=
CIBIL_PASSWORD=

# OpenAI — narrative synthesis. Without a key, a rules-based assembler writes
# the brief instead (still honest and source-linked).
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini).
OPENAI_MODEL=
