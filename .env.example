# ── Source credentials & keys ──────────────────────────────────────────────
# Copy to `.env.local`. Every value is optional — a source (or its richer mode)
# simply stays off and reports that honestly when the value is absent.

# Google / web search backend. Priority: Munshot > SerpAPI > Google
# Programmable Search > keyless fallback. Set ONE for reliable server-side
# results (the keyless fallback is blocked from most cloud servers).

# Munshot web-search (Brave-powered) — recommended, uses tooling you own.
# This one token also powers the company typeahead (birdnest stock search), the
# news deep dive, and the article reader — so keeping it fresh matters.
#
# It is a *user session* JWT and expires. Running embedded in the Munshot host,
# it is the FALLBACK rather than the source: the host hands the dashboard a live
# session token, the browser forwards it on every API call, and the sources
# authenticate with that instead (see lib/hostToken.ts). Set it anyway for
# standalone deploys and for the headless PDF render, which have no host.
MUNSHOT_TOKEN=
# Company search box backend. Override only for a different host.
# MUNSHOT_STOCK_SEARCH_URL=https://birdnest.muns.io/stock/search
# Optional overrides:
MUNSHOT_SEARCH_URL=https://fastapi.muns.io/tools/web-search
MUNSHOT_COUNTRY=IN

# Exchange filings & announcements (BSE/NSE/DRHP/screener.in). Same Muns
# platform, so it reuses MUNSHOT_TOKEN by default — set FILINGS_TOKEN only to
# override. Needs a stock ticker on the search (e.g. RELIANCE).
FILINGS_TOKEN=
FILINGS_URL=https://devde.muns.io/filings/combined_filings_announcements
FILINGS_COUNTRY=India

# ...or SerpAPI:
SERPAPI_KEY=
# ...or Google Programmable Search:
GOOGLE_API_KEY=
GOOGLE_CX=

# Indian Kanoon — optional official API token. Without it, the public search
# page is used.
INDIANKANOON_API_TOKEN=

# MCA Registry (IndiaFilings) — FREE, keyless, and the first source every
# director run consults. It settles WHO a DIN belongs to and which companies and
# LLPs are linked to it, which is what lets every later search be about a person
# rather than a name. With a DIN it costs one plain GET and no search quota.
# Override only for a mirror.
# INDIAFILINGS_BASE_URL=https://www.indiafilings.com

# News Deep Dive — searches the person, the person against each company the
# register turned up, each company alone, and then the red-flag terms. Uses the
# same MUNSHOT_TOKEN as web search, with SerpAPI's google_news engine behind it.
# Behind BOTH sits the keyless Google News RSS feed, which needs no credential
# and is reachable from a server (the keyless *web* engine is not). It is a
# floor, not a substitute: headlines only, no snippets, no query operators — so
# a run served by it says so in the brief. Set a real key for full coverage.
# How many searches one run may spend (default 24).
# MAX_NEWS_QUERIES=24

# Article reader — opens the articles worth reading, because a headline says a
# matter exists and only the body says whether the subject brought the complaint
# or answered it. Muns web-reader is primary and reuses MUNSHOT_TOKEN; Firecrawl
# is the optional fallback for publishers it cannot open. With neither, the brief
# is built from headlines and says so.
FIRECRAWL_API_KEY=
# MUNSHOT_READER_URL=https://fastapi.muns.io/tools/web-reader
# FIRECRAWL_URL=https://api.firecrawl.dev/v1/scrape
# How many articles a run may open. Each costs one reader call and one OpenAI
# extraction call, so this is the main cost dial on a deep run (default 8).
# MAX_ARTICLE_READS=8

# Company Registry (Tofler) — FREE, keyless. Directors, designations and DINs
# from the public registry record, including for UNLISTED companies. It resolves
# the company name to its record via the web-search backend above, so setting
# MUNSHOT_TOKEN makes this reliable (the keyless engine rate-limits).

# Wikidata (Directors) — FREE, keyless. Surfaces a company's directors, CEO,
# chairperson and founders, and (in director mode) the companies a person leads.
# No credential needed. Set a contact URL/email so Wikimedia can reach you per
# their API etiquette; the URL/SPARQL overrides are only for self-hosted mirrors.
WIKIDATA_CONTACT=https://github.com/techmuns/GCheck-Pragon
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# PrivateCircle — login for the Playwright collector (directorships).
PRIVATECIRCLE_EMAIL=
PRIVATECIRCLE_PASSWORD=

# CIBIL Suit-Filed portal — login for the Playwright collector (defaulters).
CIBIL_USERNAME=
CIBIL_PASSWORD=

# Search cache — how long (seconds) an identical search is reused before it
# costs quota again. Defaults to 900 (15 minutes). Covers web, news, Indian
# Kanoon and filings. Failures are never cached.
# SEARCH_CACHE_TTL_SECONDS=900

# OpenAI — narrative synthesis, and the pass that reads each opened article for
# what happened, which authority was involved, and whether the subject was the
# complainant or the accused. Without a key, a rules-based assembler writes the
# brief instead (still honest and source-linked) and no article is read.
#
# Providers are tried in order: Claude via Amazon Bedrock first, OpenAI as an
# automatic fallback. Check whichever key you set with:
#   npm run healthcheck:llm

# Bedrock API bearer token — NOT an api.anthropic.com key. Sent as x-api-key to
# https://bedrock-mantle.{region}.api.aws/anthropic/v1/messages. No AWS SDK or
# SigV4 signing involved.
BEDROCK_API_KEY=
# Optional (default: us-east-1).
BEDROCK_REGION=
# Optional comma-separated model fallback chain, tried in order. Default:
# anthropic.claude-opus-5,anthropic.claude-opus-4-8,anthropic.claude-sonnet-5
# Opus 5 access is granted per-account on Bedrock, so a 403 on the first entry
# is expected — the next model is tried automatically.
BEDROCK_MODEL_IDS=

# OpenAI — automatic fallback if Bedrock has no key or a call fails.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini).
OPENAI_MODEL=

# Provider order override. Leave UNSET for "Bedrock first, OpenAI fallback".
# Set to "openai" to put OpenAI back in front.
LLM_PROVIDER=

# How long one source may take before the run goes ahead without it. Raised from
# 75s because the news sweep and the article reads are deliberately long; the
# news, web, registry and Wikidata sources each override this with a budget that
# fits what they actually do (see lib/workflow.ts).
# SOURCE_DEADLINE_SECONDS=240
