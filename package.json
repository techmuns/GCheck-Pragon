    "test": "npm run check:keywords && npm run check:attribution && npm run check:clarifications && npm run check:search && npm run check:host-token && npm run check:firecrawl && npm run check:entity && npm run check:judgment && npm run check:substance && npm run check:archive && npm run check:history && npm run test:llm"
  },
  "dependencies": {
