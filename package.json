    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:registry": "node scripts/check-indiafilings.mjs",
    "check:keywords": "tsx scripts/check-keywords.mts",
    "check:attribution": "tsx scripts/check-attribution.mts",
    "check:clarifications": "tsx scripts/check-clarifications.mts",
    "check:search": "tsx scripts/check-search-resilience.mts",
    "check:host-token": "tsx scripts/check-host-token.mts",
    "check:firecrawl": "tsx scripts/check-firecrawl-search.mts",
    "check:entity": "tsx scripts/check-entity-match.mts",
    "check:judgment": "tsx scripts/check-judgment.mts",
    "check:substance": "tsx scripts/check-substance.mts",
    "check:related": "tsx scripts/check-related.mts",
    "check:golden": "tsx scripts/check-golden.mts",
    "check:relevance": "tsx scripts/check-relevance.mts",
    "check:archive": "tsx scripts/check-archive.mts",
    "check:history": "tsx scripts/check-history-store.mts",
    "healthcheck:llm": "node scripts/llm-healthcheck.mjs",
